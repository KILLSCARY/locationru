# Production environment for docker-compose.prod.yml.
# Copy to .env on the server and fill in real values:  cp .env.prod.example .env
# Generate secrets with:  openssl rand -base64 48

# --- Reverse proxy / TLS ---
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# --- Runtime posture ---
# NOTE ON LOGIN: in NODE_ENV=production the SMS provider must be `sms-ru`
# (real SMS.RU account, see docs/auth/sms-ru-setup.md) and the payment
# provider must be `http` (not wired yet, throws NotImplemented). For a first
# working deployment without an SMS.RU account yet, keep the development SMS
# provider below — the OTP code is then printed to the API log
# (`docker compose -f docker-compose.prod.yml logs api`). Switch SMS_PROVIDER
# to sms-ru and fill in SMS_RU_API_ID once the SMS.RU account is ready.
NODE_ENV=development
API_PORT=3000

# --- PostgreSQL (the `postgres` service; for Yandex Managed PostgreSQL point
#     DATABASE_URL at the managed host with sslmode=require) ---
POSTGRES_USER=resilient_taxi
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=resilient_taxi
DATABASE_URL=postgresql://resilient_taxi:change-me-strong-db-password@postgres:5432/resilient_taxi

# --- Redis (the `redis` service; for Yandex Managed Redis/Valkey point
#     REDIS_URL at the managed host, usually rediss:// with TLS) ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379

# --- Auth (secrets must be at least 32 characters) ---
AUTH_JWT_SECRET=change-me-access-token-secret-at-least-32-chars
AUTH_OTP_HASH_SECRET=change-me-otp-hash-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_MAX_ACTIVE_SESSIONS=10
OTP_SMS_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INITIAL_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_HOUR=5
OTP_MAX_SENDS_PER_IP_HOUR=20
OTP_BLOCK_SECONDS=900
AUTH_RATE_LIMIT_REQUEST_CODE_PER_DEVICE_HOUR=10
AUTH_RATE_LIMIT_REQUEST_CODE_GLOBAL_PER_MINUTE=500
AUTH_RATE_LIMIT_VERIFY_CODE_PER_REQUEST_PER_MINUTE=10

# --- Development admin seed (pnpm ... db:seed) ---
SEED_ADMIN_PHONE=+79990000000

# --- Trips ---
TRIPS_MIN_PASSENGER_PRICE_KOPECKS=10000
TRIPS_BOARDING_CODE_HASH_SECRET=change-me-boarding-code-secret-at-least-32-chars
TRIPS_BOARDING_CODE_MAX_ATTEMPTS=5
TRIPS_BOARDING_CODE_TTL_SECONDS=300

# --- Driver locations ---
DRIVER_LOCATIONS_BATCH_MAX_SIZE=100
DRIVER_LOCATIONS_FUTURE_TOLERANCE_SECONDS=300
DRIVER_LOCATIONS_MAX_PLAUSIBLE_SPEED_METERS_PER_SECOND=70
DRIVER_LOCATIONS_RATE_LIMIT_PER_MINUTE=120
DRIVER_LOCATIONS_STALE_AFTER_SECONDS=120
DRIVER_LOCATIONS_LATEST_POSITION_TTL_SECONDS=300

# --- Dispatch ---
DISPATCH_AVERAGE_SPEED_METERS_PER_SECOND=8.33
DISPATCH_INITIAL_RADIUS_METERS=1000
DISPATCH_LOCATION_MAX_AGE_SECONDS=120
DISPATCH_MAX_CANDIDATES=10
DISPATCH_MAX_RADIUS_METERS=5000
DISPATCH_RADIUS_MULTIPLIER=2
# straight-line (default) or http; http also needs the URL/key below.
DISPATCH_ROUTING_PROVIDER=straight-line
# DISPATCH_ROUTING_API_BASE_URL=https://routing.example/v1/
# DISPATCH_ROUTING_API_KEY=change-me
DISPATCH_ROUTING_REQUEST_TIMEOUT_MS=3000

# --- Bids ---
BIDS_TTL_SECONDS=120

# --- Finance ---
FINANCE_GLOBAL_COMMISSION_BASIS_POINTS=800
FINANCE_MIN_COMMISSION_KOPECKS=0

# --- Payments (development simulator here; for real production use http + a
#     wired gateway) ---
PAYMENTS_PROVIDER=development
# PAYMENTS_API_BASE_URL=https://api.payment-gateway.example/v1/
# PAYMENTS_API_KEY=change-me-payment-api-key
# PAYMENTS_WEBHOOK_SECRET=change-me-payment-webhook-secret
PAYMENTS_REQUEST_TIMEOUT_MS=10000

# --- SMS (development provider logs the OTP; for real production set
#     SMS_PROVIDER=sms-ru and fill in SMS_RU_API_ID) ---
SMS_PROVIDER=development
SMS_SENDER_ID=
# SMS_RU_API_ID=change-me-sms-ru-api-id
SMS_RU_API_BASE_URL=https://sms.ru
SMS_RU_TIMEOUT_MS=10000
SMS_RU_MAX_RETRIES=2
SMS_RU_CIRCUIT_FAILURE_THRESHOLD=5
SMS_RU_CIRCUIT_OPEN_MS=30000
SMS_RU_WEBHOOK_SECRET=change-me-sms-ru-webhook-secret-16-chars-min
SMS_RU_WEBHOOK_IP_ALLOWLIST=

# --- Realtime ---
REALTIME_LOCATION_EVENT_INTERVAL_SECONDS=2
REALTIME_OUTBOX_POLL_INTERVAL_MS=1000

# --- Maps (geocoding/search/routing). The offline development provider is
#     forbidden in production; set provider=yandex with a real key. ---
MAPS_PROVIDER=yandex
# MAPS_API_KEY=change-me-yandex-geocoder-api-key
MAPS_API_URL=https://geocode-maps.yandex.ru
MAPS_TIMEOUT_MS=5000
MAPS_MAX_RETRIES=2
MAPS_USER_AGENT=ResilientTaxi/1.0
MAPS_SUGGESTIONS_TTL_SECONDS=300
MAPS_GEOCODING_TTL_SECONDS=86400
MAPS_ROUTE_TTL_SECONDS=1800
MAPS_SUGGESTIONS_RATE_LIMIT_PER_MINUTE=60
MAPS_ROUTES_RATE_LIMIT_PER_MINUTE=30

# --- Pricing (a recommended fare range shown to the passenger) ---
PRICING_BASE_FARE_KOPECKS=15000
PRICING_PER_KILOMETER_KOPECKS=3000
PRICING_PER_MINUTE_KOPECKS=800
PRICING_MINIMUM_FARE_KOPECKS=15000
PRICING_LOWER_MULTIPLIER_BASIS_POINTS=9000
PRICING_UPPER_MULTIPLIER_BASIS_POINTS=13000
