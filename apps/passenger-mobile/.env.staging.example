# Staging config for the passenger app (Expo). Copy to .env or export
# these before `expo start`/`eas build` — Expo only inlines vars prefixed
# EXPO_PUBLIC_ into the client bundle, and only ones actually referenced.

# Distinguishes a staging build from production at runtime — see
# src/config/env.ts. Never left unset for a staging build.
EXPO_PUBLIC_APP_ENV=staging

EXPO_PUBLIC_API_URL=https://staging-api.example.com/api/v1

# Optional: only needed if the realtime WS endpoint isn't the API's own
# origin (see src/api/realtime.ts, which otherwise derives it from
# EXPO_PUBLIC_API_URL by stripping the /api/v1 suffix).
EXPO_PUBLIC_WS_URL=https://staging-api.example.com

EXPO_PUBLIC_MAP_PROVIDER=yandex
EXPO_PUBLIC_MAP_API_KEY=

# Forces the offline/deterministic DevelopmentMapView regardless of
# EXPO_PUBLIC_MAP_PROVIDER — useful for QA/demo builds needing consistent
# screenshots. Never honored in production builds (see MapProviderFactory.ts).
EXPO_PUBLIC_USE_MOCKS=false

# Push notifications (expo-notifications) — see docs/notifications/architecture.md.
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
