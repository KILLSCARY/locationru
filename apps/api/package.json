{
  "name": "@resilient-taxi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "prisma generate && nest build",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-e2e.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:driver": "tsx prisma/seed-driver.ts",
    "db:seed:staging": "tsx prisma/seed-staging.ts",
    "db:validate": "prisma validate",
    "simulate:trip": "tsx scripts/simulate-trip.ts",
    "staging:smoke": "tsx scripts/staging-smoke.ts"
  },
  "dependencies": {
    "@resilient-taxi/config": "workspace:*",
    "@aws-sdk/client-s3": "3.906.0",
    "@aws-sdk/s3-request-presigner": "3.906.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "ioredis": "5.11.1",
    "joi": "18.0.2",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "dotenv": "17.4.2",
    "jest": "30.2.0",
    "prisma": "7.9.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsx": "4.23.1"
  }
}
