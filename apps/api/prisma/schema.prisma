// Driver/vehicle document verification (Task 29). See docs/drivers/*.md and
// docs/security/document-*.md for the full architecture.
// ---------------------------------------------------------------------------

enum DriverDocumentType {
  PASSPORT_MAIN_PAGE
  PASSPORT_REGISTRATION
  DRIVER_LICENSE_FRONT
  DRIVER_LICENSE_BACK
  PROFILE_PHOTO
  SELFIE_WITH_DOCUMENT
  TAX_STATUS_DOCUMENT
  OTHER
}

enum VehicleDocumentType {
  VEHICLE_REGISTRATION_FRONT
  VEHICLE_REGISTRATION_BACK
  INSURANCE_POLICY
  VEHICLE_PHOTO_FRONT
  VEHICLE_PHOTO_BACK
  VEHICLE_PHOTO_LEFT
  VEHICLE_PHOTO_RIGHT
  VEHICLE_INTERIOR
  TAXI_LICENSE_FUTURE
  OTHER
}

/**
 * Shared lifecycle for both DriverDocument and VehicleDocument rows.
 */
enum DocumentStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
  FAILED_SECURITY_CHECK
}

/**
 * Centralized rejection reasons — never a free-text-only rejection, so the client can always render a specific "what to fix" message. OTHER requires rejectionComment.
 */
enum DocumentRejectionReasonCode {
  DOCUMENT_UNREADABLE
  DOCUMENT_CROPPED
  DOCUMENT_EXPIRED
  DOCUMENT_MISMATCH
  WRONG_DOCUMENT_TYPE
  PROFILE_PHOTO_MISMATCH
  DRIVER_LICENSE_INVALID
  VEHICLE_DATA_MISMATCH
  VEHICLE_TOO_OLD
  INSURANCE_EXPIRED
  SECURITY_CHECK_FAILED
  DUPLICATE_ACCOUNT
  OTHER
}

/**
 * A driver's single document "slot" for a given type. A re-upload never
 * mutates an APPROVED row in place — it creates a new DriverDocument row and
 * a new DocumentVersion tracking it (see DocumentVersion below), so the
 * previously-approved document keeps gating eligibility until the
 * replacement is itself approved.
 */
model DriverDocument {
  id                      String                       @id @default(uuid()) @db.Uuid
  driverId                String                       @db.Uuid
  type                    DriverDocumentType
  status                  DocumentStatus               @default(UPLOADING)
  objectKey               String                       @unique(map: "driver_documents_object_key_key") @db.VarChar(512)
  previewObjectKey        String?                      @db.VarChar(512)
  fileNameSanitized       String                       @db.VarChar(255)
  mimeType                String                       @db.VarChar(128)
  fileSize                Int
  documentNumberEncrypted String?                      @db.VarChar(512)
  documentNumberHash      String?                      @db.VarChar(128)
  documentNumberLastFour  String?                      @db.VarChar(4)
  issuedAt                DateTime?                    @db.Date
  expiresAt               DateTime?                    @db.Date
  issuingCountry          String                       @default("RU") @db.VarChar(2)
  rejectionReasonCode     DocumentRejectionReasonCode?
  rejectionComment        String?                      @db.VarChar(1024)
  reviewedBy              String?                      @db.Uuid
  reviewedAt              DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(3)
  version                 Int                          @default(0)
  driver                  DriverProfile                @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  reviewer                User?                        @relation("DriverDocumentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  documentVersions        DocumentVersion[]            @relation("DriverDocumentVersions")

  @@index([driverId, type], map: "driver_documents_driver_type_idx")
  @@index([status], map: "driver_documents_status_idx")
  @@index([expiresAt], map: "driver_documents_expires_at_idx")
  @@index([documentNumberHash], map: "driver_documents_number_hash_idx")
  @@map("driver_documents")
}

model VehicleDocument {
  id                      String                       @id @default(uuid()) @db.Uuid
  vehicleId               String                       @db.Uuid
  type                    VehicleDocumentType
  status                  DocumentStatus               @default(UPLOADING)
  objectKey               String                       @unique(map: "vehicle_documents_object_key_key") @db.VarChar(512)
  previewObjectKey        String?                      @db.VarChar(512)
  fileNameSanitized       String                       @db.VarChar(255)
  mimeType                String                       @db.VarChar(128)
  fileSize                Int
  documentNumberEncrypted String?                      @db.VarChar(512)
  documentNumberHash      String?                      @db.VarChar(128)
  documentNumberLastFour  String?                      @db.VarChar(4)
  issuedAt                DateTime?                    @db.Date
  expiresAt               DateTime?                    @db.Date
  issuingCountry          String                       @default("RU") @db.VarChar(2)
  rejectionReasonCode     DocumentRejectionReasonCode?
  rejectionComment        String?                      @db.VarChar(1024)
  reviewedBy              String?                      @db.Uuid
  reviewedAt              DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(3)
  version                 Int                          @default(0)
  vehicle                 Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reviewer                User?                        @relation("VehicleDocumentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  documentVersions        DocumentVersion[]            @relation("VehicleDocumentVersions")

  @@index([vehicleId, type], map: "vehicle_documents_vehicle_type_idx")
  @@index([status], map: "vehicle_documents_status_idx")
  @@index([expiresAt], map: "vehicle_documents_expires_at_idx")
  @@index([documentNumberHash], map: "vehicle_documents_number_hash_idx")
  @@map("vehicle_documents")
}

enum DocumentVersionStatus {
  /** The version currently counted for eligibility/display — exactly one per documentFamily. */
  ACTIVE
  /** Was ACTIVE until a later version was approved and took over. */
  SUPERSEDED
  /** Uploaded but not yet (or no longer, e.g. rejected) the decided version — see docs/drivers/documents.md. */
  PENDING_REVIEW
}

/**
 * Version-tracking index over DriverDocument/VehicleDocument rows — the
 * underlying rows are themselves never mutated into a "superseded" state
 * (DocumentStatus has no such value); this table is what actually answers
 * "which version is the currently-active one for this driver+type slot".
 * `documentFamily` groups every version of the same logical document, e.g.
 * `driver:<driverId>:<type>` or `vehicle:<vehicleId>:<type>`.
 */
model DocumentVersion {
  id                String                @id @default(uuid()) @db.Uuid
  documentFamily    String                @db.VarChar(160)
  versionNumber     Int
  status            DocumentVersionStatus @default(PENDING_REVIEW)
  driverDocumentId  String?               @db.Uuid
  vehicleDocumentId String?               @db.Uuid
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  supersededAt      DateTime?             @db.Timestamptz(3)
  driverDocument    DriverDocument?       @relation("DriverDocumentVersions", fields: [driverDocumentId], references: [id], onDelete: Cascade)
  vehicleDocument   VehicleDocument?      @relation("VehicleDocumentVersions", fields: [vehicleDocumentId], references: [id], onDelete: Cascade)

  @@unique([documentFamily, versionNumber], map: "document_versions_family_version_key")
  @@index([documentFamily, status], map: "document_versions_family_status_idx")
  @@map("document_versions")
}

enum VerificationCaseStatus {
  CREATED
  QUEUED
  ASSIGNED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  ESCALATED
}

enum VerificationCaseDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum VerificationCasePriority {
  NORMAL
  HIGH
}

/**
 * One case per verification submission attempt. `submittedSnapshot` freezes
 * the profile/vehicle/document state at submission time for audit purposes
 * (what the admin actually reviewed, even if the driver's live profile
 * changes later). Application code (VerificationSubmissionService) enforces
 * "one active case per driver" — CREATED/QUEUED/ASSIGNED/IN_REVIEW/
 * CHANGES_REQUESTED/ESCALATED count as active; there is deliberately no DB
 * partial-unique-index for this (would require hand-written migration SQL)
 * — see docs/drivers/verification.md for the trade-off.
 */
model VerificationCase {
  id                   String                        @id @default(uuid()) @db.Uuid
  driverId             String                        @db.Uuid
  status               VerificationCaseStatus        @default(CREATED)
  submittedSnapshot    Json
  duplicateCheckResult Json?
  assignedAdminId      String?                       @db.Uuid
  priority             VerificationCasePriority      @default(NORMAL)
  createdAt            DateTime                      @default(now()) @db.Timestamptz(3)
  assignedAt           DateTime?                     @db.Timestamptz(3)
  reviewedAt           DateTime?                     @db.Timestamptz(3)
  completedAt          DateTime?                     @db.Timestamptz(3)
  decision             VerificationCaseDecision?
  decisionReasonCodes  DocumentRejectionReasonCode[]
  publicComment        String?                       @db.VarChar(1024)
  internalComment      String?                       @db.VarChar(2048)
  version              Int                           @default(0)
  driver               DriverProfile                 @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  assignedAdmin        User?                         @relation("VerificationCaseAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status], map: "verification_cases_status_idx")
  @@index([driverId, status], map: "verification_cases_driver_status_idx")
  @@map("verification_cases")
}

enum DriverConsentType {
  PERSONAL_DATA_PROCESSING
  DOCUMENT_PROCESSING
  BIOMETRIC_PROCESSING_FUTURE
  TERMS_OF_SERVICE
  DRIVER_PARTNER_AGREEMENT
}

/**
 * Real biometric processing is not implemented (Task 29 explicitly excludes it) — BIOMETRIC_PROCESSING_FUTURE exists only as a reserved value for if/when it is.
 */
model DriverConsent {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  consentType     DriverConsentType
  documentVersion String            @db.VarChar(32)
  acceptedAt      DateTime          @default(now()) @db.Timestamptz(3)
  ipHash          String?           @db.VarChar(128)
  deviceId        String?           @db.VarChar(255)
  revokedAt       DateTime?         @db.Timestamptz(3)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType], map: "driver_consents_user_type_idx")
  @@map("driver_consents")
}

enum DuplicateMatchResult {
  NO_MATCH
  POSSIBLE_MATCH
  STRONG_MATCH
  MANUAL_REVIEW_REQUIRED
}

enum DeletionQueueStatus {
  PENDING
  LEGAL_HOLD
  DELETED
  CANCELLED
}

/**
 * Retention/deletion queue (Task 29 section 24) — nothing is ever deleted
 * immediately on request; it is queued here and only actually deleted once
 * `eligibleAt` has passed and status is still PENDING (never LEGAL_HOLD).
 * The actual retention durations are configuration, not a legal
 * determination made in code — see docs/decisions/driver-legal-requirements.md.
 */
model DocumentDeletionQueueEntry {
  id              String              @id @default(uuid()) @db.Uuid
  documentType    String              @db.VarChar(16)
  documentId      String              @db.Uuid
  reason          String              @db.VarChar(64)
  eligibleAt      DateTime            @db.Timestamptz(3)
  status          DeletionQueueStatus @default(PENDING)
  legalHoldReason String?             @db.VarChar(255)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?           @db.Timestamptz(3)

  @@index([status, eligibleAt], map: "document_deletion_queue_status_eligible_idx")
  @@map("document_deletion_queue")
}

enum OtpPurpose {
  LOGIN
  DRIVER_REGISTRATION
  PHONE_CHANGE
  SENSITIVE_ACTION
}

enum OtpStatus {
  CREATED
  SENDING
  SENT
  DELIVERED
  FAILED
  VERIFIED
  EXPIRED
  BLOCKED
  CONSUMED
}

enum VerificationChannel {
  SMS
  FLASH_CALL
  INCOMING_CALL
  STAGING
}

/**
 * One row per OTP request — history/analytics/delivery-status only. The
 * plaintext code is never stored here (only `codeHash`); `phoneHash` (not
 * the raw phone) is stored too, so this table stays safe to query for
 * abuse analytics without doubling as another place the phone number
 * lives in plaintext. OtpService owns the actual live code/attempts state
 * in Redis (see docs/auth/otp-architecture.md) — this table is the
 * durable record of what happened, not the source of truth for an
 * in-flight verification.
 */
model OtpRequest {
  id                String              @id @default(uuid()) @db.Uuid
  phoneHash         String              @db.VarChar(128)
  purpose           OtpPurpose
  channel           VerificationChannel
  codeHash          String              @db.VarChar(255)
  status            OtpStatus           @default(CREATED)
  expiresAt         DateTime            @db.Timestamptz(3)
  attemptsUsed      Int                 @default(0)
  maxAttempts       Int
  resendAvailableAt DateTime            @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  verifiedAt        DateTime?           @db.Timestamptz(3)
  consumedAt        DateTime?           @db.Timestamptz(3)
  providerMessageId String?             @db.VarChar(128)
  providerStatus    String?             @db.VarChar(32)

  @@index([phoneHash, purpose, createdAt], map: "otp_requests_phone_purpose_created_idx")
  @@index([status], map: "otp_requests_status_idx")
  @@index([providerMessageId], map: "otp_requests_provider_message_id_idx")
  @@map("otp_requests")
}

enum SecurityEventType {
  OTP_BRUTE_FORCE_SUSPECTED
  REFRESH_TOKEN_REUSE
  PHONE_BLOCKED
  DEVICE_BLOCKED
  PROVIDER_CIRCUIT_OPEN
  PUSH_TOKEN_MASS_REGISTRATION_SUSPECTED
}

/**
 * Security-relevant events with no raw phone number or OTP in the payload.
 */
model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  type      SecurityEventType
  phoneHash String?           @db.VarChar(128)
  userId    String?           @db.Uuid
  deviceId  String?           @db.VarChar(255)
  ipHash    String?           @db.VarChar(128)
  metadata  Json
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt], map: "security_events_type_created_idx")
  @@index([phoneHash, createdAt], map: "security_events_phone_created_idx")
  @@map("security_events")
}

/**
 * A temporary (or, for a manual admin action, indefinite-until-unblocked)
 * hold on a phone number or device. Automatic blocks (progressive OTP
 * abuse protection) always carry an `expiresAt` — nothing here is ever
 * permanent by automation, only a human via the admin panel can leave one
 * open-ended, and every unblock is audited.
 */
model AuthBlock {
  id                 String    @id @default(uuid()) @db.Uuid
  phoneHash          String?   @db.VarChar(128)
  deviceId           String?   @db.VarChar(255)
  reason             String    @db.VarChar(255)
  createdByAdminId   String?   @db.Uuid
  blockedAt          DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime? @db.Timestamptz(3)
  unblockedAt        DateTime? @db.Timestamptz(3)
  unblockedByAdminId String?   @db.Uuid

  @@index([phoneHash, unblockedAt], map: "auth_blocks_phone_active_idx")
  @@index([deviceId, unblockedAt], map: "auth_blocks_device_active_idx")
  @@map("auth_blocks")
}

/**
 * Idempotency guard for SMS.RU webhook deliveries — the provider may
 * redeliver the same event, and `rawEventHash` (a hash of the raw request
 * body) being unique means a duplicate insert simply fails instead of
 * processing the event twice.
 */
model SmsWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @db.VarChar(32)
  rawEventHash      String    @unique(map: "sms_webhook_events_raw_event_hash_key") @db.VarChar(64)
  providerMessageId String?   @db.VarChar(128)
  status            String    @db.VarChar(32)
  receivedAt        DateTime  @default(now()) @db.Timestamptz(3)
  processedAt       DateTime? @db.Timestamptz(3)

  @@index([providerMessageId], map: "sms_webhook_events_provider_message_id_idx")
  @@map("sms_webhook_events")
}

// ---------------------------------------------------------------------------
// Notifications (Task 28): push delivery + an in-app inbox that survives
// even when push itself fails or is disabled. See docs/notifications/*.md.
// Push is never the source of truth — opening a notification always
// re-syncs from REST/WebSocket; these tables exist to get the user's
// attention and to make delivery auditable, not to hold live trip state.
// ---------------------------------------------------------------------------

enum PushPlatform {
  ANDROID
  IOS
}

enum PushApplication {
  PASSENGER
  DRIVER
}

enum PushProviderType {
  DEVELOPMENT
  STAGING
  FCM
  APNS
}

enum PushTokenStatus {
  ACTIVE
  INVALID
  REVOKED
  EXPIRED
}

/**
 * Mirrors AppEnvironment (packages/config) as its own Prisma enum — kept
 * separate so a raw token's environment is a durable, queryable column
 * rather than something inferred at read time. Always set from the
 * server's own `app.appEnvironment` at registration, never trusted from
 * the client — see docs/notifications/device-tokens.md for why that's
 * what actually prevents a production token being registered in staging.
 */
enum PushEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum NotificationType {
  DRIVER_NEW_TRIP_AVAILABLE
  DRIVER_BID_ACCEPTED
  DRIVER_BID_REJECTED
  DRIVER_TRIP_CANCELLED
  DRIVER_PAYMENT_RESERVED
  DRIVER_PICKUP_REMINDER
  DRIVER_LOCATION_DEGRADED
  DRIVER_DOCUMENT_EXPIRING
  DRIVER_ACCOUNT_APPROVED
  DRIVER_ACCOUNT_REJECTED
  DRIVER_PAYOUT_COMPLETED
  DRIVER_PAYOUT_FAILED
  PASSENGER_BID_RECEIVED
  PASSENGER_DRIVER_SELECTED
  PASSENGER_DRIVER_EN_ROUTE
  PASSENGER_DRIVER_ARRIVED
  PASSENGER_TRIP_STARTED
  PASSENGER_TRIP_COMPLETED
  PASSENGER_TRIP_CANCELLED
  PASSENGER_PAYMENT_RESERVED
  PASSENGER_PAYMENT_FAILED
  PASSENGER_REFUND_COMPLETED
  SECURITY_SESSION_REVOKED
  SYSTEM_SERVICE_NOTICE
}

enum NotificationCategory {
  TRIP_OFFERS
  ACTIVE_TRIP
  PAYMENTS
  DRIVER_OPERATIONS
  ACCOUNT
  SECURITY
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  PARTIALLY_SENT
  FAILED
  CANCELLED
  EXPIRED
}

/**
 * CRITICAL is reserved for NotificationCategory.SECURITY events — never assigned to an ordinary trip/bid/payment notification.
 */
enum NotificationPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  PROVIDER_ACCEPTED
  DELIVERED
  OPENED
  RETRY_SCHEDULED
  FAILED_TEMPORARY
  FAILED_PERMANENT
  TOKEN_INVALID
}

/**
 * Outbox-row lifecycle, distinct from NotificationStatus (which tracks the rendered Notification, created only once an outbox row is processed).
 */
enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
  EXPIRED
  DEAD_LETTER
}

/**
 * What a device's lock screen may show for a notification's title/body. Defaults to GENERIC for sensitive categories — see docs/notifications/privacy.md.
 */
enum NotificationPreviewMode {
  FULL
  GENERIC
  HIDDEN
}

/**
 * A registered push destination. One row per (application, device) — the
 * same physical phone has independent rows for a passenger install and a
 * driver install. `encryptedToken` is the only place the raw provider
 * token is stored (AES-256-GCM, key from PUSH_TOKEN_ENCRYPTION_KEY) and it
 * is never logged; `tokenHash` (HMAC-SHA256) is what uniqueness and
 * lookups use instead. Replacing a token (refresh) revokes the old row
 * rather than updating it in place, preserving delivery history.
 */
model DevicePushToken {
  id                      String                 @id @default(uuid()) @db.Uuid
  userId                  String                 @db.Uuid
  deviceSessionId         String                 @db.Uuid
  deviceId                String                 @db.VarChar(255)
  application             PushApplication
  platform                PushPlatform
  provider                PushProviderType
  environment             PushEnvironment
  encryptedToken          String                 @db.Text
  tokenHash               String                 @unique(map: "device_push_tokens_token_hash_key") @db.VarChar(128)
  status                  PushTokenStatus        @default(ACTIVE)
  appVersion              String?                @db.VarChar(32)
  osVersion               String?                @db.VarChar(32)
  locale                  String?                @db.VarChar(16)
  timezone                String?                @db.VarChar(64)
  notificationsPermission Boolean
  lastRegisteredAt        DateTime               @default(now()) @db.Timestamptz(3)
  lastUsedAt              DateTime?              @db.Timestamptz(3)
  invalidatedAt           DateTime?              @db.Timestamptz(3)
  invalidationReason      String?                @db.VarChar(64)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSession           DeviceSession          @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  deliveries              NotificationDelivery[]

  @@index([userId], map: "device_push_tokens_user_idx")
  @@index([deviceSessionId], map: "device_push_tokens_device_session_idx")
  @@index([status], map: "device_push_tokens_status_idx")
  @@index([application, environment], map: "device_push_tokens_app_environment_idx")
  @@map("device_push_tokens")
}

/**
 * Transactional outbox for notification-worthy domain events — enqueued in
 * the same Prisma transaction as the business write it announces (mirrors
 * RealtimeOutboxEvent's pattern; see RealtimeOutboxService). One row per
 * intended recipient. `deduplicationKey` is the idempotency guard: the same
 * source event (e.g. a trip transition retried after a crash) must never
 * enqueue twice, and the worker also upserts Notification by this same key
 * so a crash between "Notification created" and "outbox row marked
 * DELIVERED" can't double-send either.
 */
model NotificationOutboxEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  type             NotificationType
  userId           String                   @db.Uuid
  application      PushApplication
  entityType       String                   @db.VarChar(32)
  entityId         String?                  @db.Uuid
  payload          Json
  priority         NotificationPriority
  deduplicationKey String                   @unique(map: "notification_outbox_events_dedup_key_key") @db.VarChar(255)
  /**
   * Groups events belonging to the same SUPERSEDE/COLLAPSE_COUNT family (see NotificationService.computeCollapseKey) — never unique, several rows can share one while at most one is still PENDING.
   */
  collapseKey      String                   @db.VarChar(255)
  status           NotificationOutboxStatus @default(PENDING)
  attempts         Int                      @default(0)
  maxAttempts      Int
  availableAt      DateTime                 @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime?                @db.Timestamptz(3)
  notificationId   String?                  @db.Uuid
  lastError        String?                  @db.VarChar(512)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  processedAt      DateTime?                @db.Timestamptz(3)

  @@index([status, availableAt], map: "notification_outbox_events_status_available_at_idx")
  @@index([userId, type], map: "notification_outbox_events_user_type_idx")
  @@index([collapseKey, status], map: "notification_outbox_events_collapse_key_status_idx")
  @@map("notification_outbox_events")
}

/**
 * The durable, user-facing notification record — exists independently of
 * whether push delivery succeeded (see NotificationDelivery), so it can
 * always be shown in the in-app inbox. `titleTemplate`/`bodyTemplate` hold
 * the actually-rendered text at send time (not a template key) alongside
 * `templateVersion`, so historical/admin views show exactly what a user
 * saw even after a template is edited later.
 */
model Notification {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  type             NotificationType
  application      PushApplication
  entityType       String                 @db.VarChar(32)
  entityId         String?                @db.Uuid
  titleTemplate    String                 @db.VarChar(128)
  bodyTemplate     String                 @db.VarChar(512)
  templateVersion  Int
  payload          Json
  status           NotificationStatus     @default(PENDING)
  priority         NotificationPriority
  deduplicationKey String                 @unique(map: "notifications_dedup_key_key") @db.VarChar(255)
  scheduledAt      DateTime               @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  sentAt           DateTime?              @db.Timestamptz(3)
  deliveredAt      DateTime?              @db.Timestamptz(3)
  openedAt         DateTime?              @db.Timestamptz(3)
  /**
   * Marked via POST .../read or read-all — distinct from openedAt (a push tap), since the in-app inbox can mark something read without the push ever being opened.
   */
  readAt           DateTime?              @db.Timestamptz(3)
  failedAt         DateTime?              @db.Timestamptz(3)
  expiresAt        DateTime?              @db.Timestamptz(3)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries       NotificationDelivery[]

  @@index([userId, createdAt], map: "notifications_user_created_at_idx")
  @@index([userId, readAt], map: "notifications_user_read_at_idx")
  @@index([status], map: "notifications_status_idx")
  @@map("notifications")
}

/**
 * One row per (Notification, DevicePushToken) delivery attempt. Multiple
 * rows accumulate across retries (see `attempt`). PROVIDER_ACCEPTED means
 * only that FCM/APNs queued the message — never treated as proof the user
 * actually saw it; OPENED is the only status that reflects real viewing,
 * set when the client reports the notificationId back via POST .../opened.
 */
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  devicePushTokenId String                     @db.Uuid
  provider          PushProviderType
  providerMessageId String?                    @db.VarChar(255)
  attempt           Int                        @default(1)
  status            NotificationDeliveryStatus @default(QUEUED)
  errorCode         String?                    @db.VarChar(64)
  errorCategory     String?                    @db.VarChar(32)
  sentAt            DateTime?                  @db.Timestamptz(3)
  acknowledgedAt    DateTime?                  @db.Timestamptz(3)
  failedAt          DateTime?                  @db.Timestamptz(3)
  nextRetryAt       DateTime?                  @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  devicePushToken   DevicePushToken            @relation(fields: [devicePushTokenId], references: [id], onDelete: Cascade)

  @@index([notificationId], map: "notification_deliveries_notification_idx")
  @@index([devicePushTokenId], map: "notification_deliveries_device_push_token_idx")
  @@index([status, nextRetryAt], map: "notification_deliveries_status_next_retry_idx")
  @@map("notification_deliveries")
}

/**
 * Per (user, application, category) opt-out. Rows are optional — a missing
 * row means the category's default (enabled) applies. SECURITY and an
 * in-progress ACTIVE_TRIP are enforced server-side as always-on regardless
 * of what's stored here (see NotificationPreferenceService); the OS-level
 * permission still overrides everything, this only controls in-app intent.
 */
model NotificationPreference {
  userId           String               @db.Uuid
  application      PushApplication
  category         NotificationCategory
  pushEnabled      Boolean              @default(true)
  soundEnabled     Boolean              @default(true)
  vibrationEnabled Boolean              @default(true)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, application, category])
  @@map("notification_preferences")
}

/**
 * One row per user: how much a sensitive notification's title/body may
 * reveal on a locked device. Separate from NotificationPreference (which
 * is per category) since preview mode is a single cross-category privacy
 * dial, not an on/off switch per event type.
 */
model NotificationPrivacySetting {
  userId      String                  @id @db.Uuid
  previewMode NotificationPreviewMode @default(GENERIC)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_privacy_settings")
}
