NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

POSTGRES_USER=resilient_taxi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resilient_taxi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resilient_taxi:change-me@localhost:5432/resilient_taxi
SEED_ADMIN_PHONE=+79990000000

REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379

AUTH_JWT_SECRET=change-me-access-token-secret-at-least-32-chars
AUTH_OTP_HASH_SECRET=change-me-otp-hash-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_LIMIT=3
AUTH_OTP_REQUEST_WINDOW_SECONDS=60

# SMS. В development используется провайдер, который пишет OTP в лог
# (provider=development). Для production задайте provider=http и значения шлюза.
SMS_PROVIDER=development
SMS_API_BASE_URL=https://api.sms-gateway.example/v1/
SMS_API_KEY=change-me-sms-api-key
SMS_SENDER=ResilientTaxi
SMS_REQUEST_TIMEOUT_MS=10000

TRIPS_MIN_PASSENGER_PRICE_KOPECKS=10000
TRIPS_BOARDING_CODE_HASH_SECRET=change-me-boarding-code-secret-at-least-32-chars
TRIPS_BOARDING_CODE_MAX_ATTEMPTS=5
TRIPS_BOARDING_CODE_TTL_SECONDS=300

DRIVER_LOCATIONS_BATCH_MAX_SIZE=100
DRIVER_LOCATIONS_FUTURE_TOLERANCE_SECONDS=300
DRIVER_LOCATIONS_MAX_PLAUSIBLE_SPEED_METERS_PER_SECOND=70
DRIVER_LOCATIONS_RATE_LIMIT_PER_MINUTE=120
DRIVER_LOCATIONS_STALE_AFTER_SECONDS=120
DRIVER_LOCATIONS_LATEST_POSITION_TTL_SECONDS=300

DISPATCH_AVERAGE_SPEED_METERS_PER_SECOND=8.33
DISPATCH_INITIAL_RADIUS_METERS=1000
DISPATCH_LOCATION_MAX_AGE_SECONDS=120
DISPATCH_MAX_CANDIDATES=10
DISPATCH_MAX_RADIUS_METERS=5000
DISPATCH_RADIUS_MULTIPLIER=2

# Маршрутизация для оценки времени подачи. straight-line — геодезическая
# модель по прямой (допустима в production). http — внешний routing API с
# фолбэком на прямую при недоступности.
DISPATCH_ROUTING_PROVIDER=straight-line
DISPATCH_ROUTING_API_BASE_URL=https://api.routing-gateway.example/v1/
DISPATCH_ROUTING_API_KEY=change-me-routing-api-key
DISPATCH_ROUTING_REQUEST_TIMEOUT_MS=3000

BIDS_TTL_SECONDS=120

FINANCE_GLOBAL_COMMISSION_BASIS_POINTS=800
FINANCE_MIN_COMMISSION_KOPECKS=0

# Платежи. В development используется локальный симулятор (provider=development).
# Для production задайте provider=http и реальные значения шлюза.
PAYMENTS_PROVIDER=development
PAYMENTS_API_BASE_URL=https://api.payment-gateway.example/v1/
PAYMENTS_API_KEY=change-me-payment-api-key
PAYMENTS_WEBHOOK_SECRET=change-me-payment-webhook-secret
PAYMENTS_REQUEST_TIMEOUT_MS=10000

REALTIME_LOCATION_EVENT_INTERVAL_SECONDS=2
REALTIME_OUTBOX_POLL_INTERVAL_MS=1000

# Карты: геокодинг, поиск адресов и маршруты. В development используется
# DevelopmentMapsProvider — офлайн-провайдер без сети (provider=development).
# Для production задайте provider=yandex и реальный ключ — офлайн-провайдер в
# production запрещён.
MAPS_PROVIDER=development
MAPS_API_KEY=
MAPS_API_URL=https://geocode-maps.yandex.ru
MAPS_TIMEOUT_MS=5000
MAPS_MAX_RETRIES=2
MAPS_USER_AGENT=ResilientTaxi/1.0
MAPS_SUGGESTIONS_TTL_SECONDS=300
MAPS_GEOCODING_TTL_SECONDS=86400
MAPS_ROUTE_TTL_SECONDS=1800
MAPS_SUGGESTIONS_RATE_LIMIT_PER_MINUTE=60
MAPS_ROUTES_RATE_LIMIT_PER_MINUTE=30

# Рекомендованная цена поездки (не финальный тариф — пассажир может предложить
# свою цену, если она не ниже системного минимума).
PRICING_BASE_FARE_KOPECKS=15000
PRICING_PER_KILOMETER_KOPECKS=3000
PRICING_PER_MINUTE_KOPECKS=800
PRICING_MINIMUM_FARE_KOPECKS=15000
PRICING_LOWER_MULTIPLIER_BASIS_POINTS=9000
PRICING_UPPER_MULTIPLIER_BASIS_POINTS=13000

# Карта пассажирского приложения (Expo). Expo встраивает в клиентский бандл
# только переменные с префиксом EXPO_PUBLIC_ — без него значение будет
# недоступно в собранном приложении. development — DevelopmentMapView без SDK
# и без сети, запрещён в production-сборке (см. MapProviderFactory.ts).
EXPO_PUBLIC_MAP_PROVIDER=development
EXPO_PUBLIC_MAP_API_KEY=
# Зарезервировано для стиля карты реального SDK — пока не используется:
# DevelopmentMapView отрисовывается без него.
EXPO_PUBLIC_MAP_STYLE_URL=

# Карта водительского приложения (Android). Реально считываемое имя —
# MAPKIT_API_KEY (Gradle-свойство -PmapkitApiKey=... или переменная окружения,
# тот же секрет, что использует android-apk.yml); ANDROID_MAP_PROVIDER/
# ANDROID_MAP_API_KEY документируют то же самое под именами из тех.задания.
# У driver-android только один реальный провайдер (Yandex MapKit) — выбор
# идёт по наличию ключа: пусто -> DevelopmentMapView, задан -> Yandex MapKit;
# production-сборка (assembleProd*/bundleProd*) без ключа не соберётся.
ANDROID_MAP_PROVIDER=yandex
ANDROID_MAP_API_KEY=
MAPKIT_API_KEY=

# Общие параметры отрисовки живой позиции водителя. Подключены на стороне
# passenger-mobile (DriverMarkerInterpolator.ts, locationQuality.ts,
# app/trip/[id].tsx) — там имя обязано нести префикс EXPO_PUBLIC_, иначе Expo
# не встроит значение в клиентский бандл, поэтому реально считываются
# EXPO_PUBLIC_MAP_DRIVER_INTERPOLATION_MS и т.д. ниже; беспрефиксные имена —
# те же значения под названиями из тех.задания, для документации. На стороне
# driver-android эквивалентные классы (InterpolatorOptions,
# LocationQualityThresholds) в core/maps используют те же значения по
# умолчанию, но ещё не вызываются ни из одного экрана — у водительского
# приложения пока нет экрана "в пути" после принятия заказа, где
# отображалась бы чужая сглаживаемая позиция.
MAP_DRIVER_INTERPOLATION_MS=1000
MAP_LOCATION_STALE_SECONDS=15
MAP_LOCATION_UNAVAILABLE_SECONDS=60
MAP_MAX_RENDER_UPDATE_HZ=5
EXPO_PUBLIC_MAP_DRIVER_INTERPOLATION_MS=1000
EXPO_PUBLIC_MAP_LOCATION_STALE_SECONDS=15
EXPO_PUBLIC_MAP_LOCATION_UNAVAILABLE_SECONDS=60
EXPO_PUBLIC_MAP_MAX_RENDER_UPDATE_HZ=5
