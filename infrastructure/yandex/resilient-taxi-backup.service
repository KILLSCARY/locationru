[Unit]
Description=Upload Resilient Taxi backups to Yandex Object Storage
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=killscary
Group=killscary
WorkingDirectory=/opt/resilient-taxi
EnvironmentFile=/etc/resilient-taxi/yandex-backup.env
ExecStart=/bin/sh /opt/resilient-taxi/infrastructure/yandex/upload-backups.sh

[Install]
WantedBy=multi-user.target
