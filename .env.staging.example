# Staging environment for docker-compose.staging.yml.
# Copy to .env.staging on the server and fill in real values, generating
# every secret freshly — never reuse a value from this file or from
# .env.example/.env.prod.example, and never commit the filled-in file.
#   cp .env.staging.example .env.staging
#   openssl rand -base64 48   # for each *_SECRET below
#
# See docs/staging/configuration.md for what every variable does and
# docs/staging/security.md for why staging refuses to boot without them.

# --- Deployment tier ---
# APP_ENV governs security-relevant behavior (which providers are allowed,
# whether Swagger is exposed, CORS strictness). NODE_ENV=production only
# tells Node/npm to run in its optimized mode — it does NOT by itself grant
# any of the unsafe behavior APP_ENV=production/staging forbids.
APP_ENV=staging
NODE_ENV=production

# --- API process ---
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=https://staging-api.example.com
ADMIN_PUBLIC_URL=https://staging-admin.example.com
HTTP_BODY_LIMIT_BYTES=262144

# --- Data stores (point at the docker-compose.staging.yml services, or a
#     managed Postgres/Redis if you're not running them in-cluster) ---
POSTGRES_USER=resilient_taxi_staging
POSTGRES_PASSWORD=
POSTGRES_DB=resilient_taxi_staging
DATABASE_URL=postgresql://resilient_taxi_staging:CHANGE_ME@postgres:5432/resilient_taxi_staging
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# --- Auth ---
# The task spec names these JWT_ACCESS_SECRET/JWT_REFRESH_SECRET/
# JWT_ACCESS_TTL_SECONDS/JWT_REFRESH_TTL_SECONDS. This codebase's actual auth
# design uses a single AUTH_JWT_SECRET to sign short-lived access tokens;
# refresh tokens are NOT JWTs — they are opaque, per-session random values,
# hashed with scrypt and rotated on every use (AuthService.createRefreshToken/
# verifySecretHash) — a design that doesn't have (and doesn't need) a shared
# "refresh secret" the way a JWT-based refresh token would. So there is no
# JWT_REFRESH_SECRET to set; AUTH_REFRESH_TOKEN_TTL_SECONDS covers the TTL
# side. See docs/staging/configuration.md for the full mapping.
AUTH_JWT_SECRET=
AUTH_OTP_HASH_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_MAX_ACTIVE_SESSIONS=10
OTP_SMS_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INITIAL_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_HOUR=5
OTP_MAX_SENDS_PER_IP_HOUR=20
OTP_BLOCK_SECONDS=900
AUTH_RATE_LIMIT_REQUEST_CODE_PER_DEVICE_HOUR=10
AUTH_RATE_LIMIT_REQUEST_CODE_GLOBAL_PER_MINUTE=500
AUTH_RATE_LIMIT_VERIFY_CODE_PER_REQUEST_PER_MINUTE=10
TRIPS_BOARDING_CODE_HASH_SECRET=

# --- CORS / WebSocket ---
# Comma-separated; "*" is rejected. Required in staging.
CORS_ALLOWED_ORIGINS=https://staging-admin.example.com
WEBSOCKET_ALLOWED_ORIGINS=https://staging-admin.example.com
WEBSOCKET_MAX_CONNECTIONS_PER_USER=10
WEBSOCKET_HEARTBEAT_INTERVAL_MS=25000
WEBSOCKET_HEARTBEAT_TIMEOUT_MS=20000
WEBSOCKET_EVENT_RATE_LIMIT_PER_MINUTE=300

# --- SMS: never a real gateway by default in staging ---
# SMS_PROVIDER must be "staging" or "sms-ru" here — "development" is rejected
# by env validation. StagingSmsProvider sends nothing; the OTP is retrievable
# only via GET /api/v1/admin/staging/otp/:phone (SUPER_ADMIN, audited).
# Set SMS_PROVIDER=sms-ru + SMS_RU_API_ID below only for the deliberate,
# one-off staging SMS.RU verification run (pnpm staging:test:sms) — see
# docs/auth/sms-ru-setup.md.
SMS_PROVIDER=staging
SMS_SENDER_ID=
SMS_RU_API_ID=
SMS_RU_API_BASE_URL=https://sms.ru
SMS_RU_TIMEOUT_MS=10000
SMS_RU_MAX_RETRIES=2
SMS_RU_CIRCUIT_FAILURE_THRESHOLD=5
SMS_RU_CIRCUIT_OPEN_MS=30000
SMS_RU_WEBHOOK_SECRET=
SMS_RU_WEBHOOK_IP_ALLOWLIST=

# --- Payments: never real money in staging ---
# PAYMENTS_PROVIDER must be "staging" or "http" here — "development" is
# rejected. StagingPaymentProvider never moves money; scenarios are
# configured only through the SUPER_ADMIN staging tool, never by a client.
PAYMENTS_PROVIDER=staging
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_REQUEST_TIMEOUT_MS=10000
STAGING_PAYMENT_DEFAULT_SCENARIO=SUCCESS

# --- Maps ---
# yandex is the default expectation in staging; set MAPS_API_KEY to a real
# (non-production-billing) Yandex key. To run staging fully offline instead,
# set MAPS_PROVIDER=development and MAPS_ALLOW_DEVELOPMENT_IN_STAGING=true —
# both are required together, env validation rejects one without the other.
MAPS_PROVIDER=yandex
MAPS_ALLOW_DEVELOPMENT_IN_STAGING=false
MAPS_API_KEY=

# --- Object storage (documents) — S3-compatible; docker-compose.staging.yml
#     runs MinIO for this by default ---
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=resilient-taxi-staging
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760
OBJECT_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=300
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# --- Observability ---
LOG_LEVEL=info
ERROR_REPORTER=noop
ERROR_REPORTER_DSN=

# --- Feature gates staging must keep off (env validation hard-rejects any
#     of these being true while APP_ENV=staging; kept explicit here as
#     documentation of the posture, not as something you can flip) ---
ENABLE_SWAGGER=false
ENABLE_DEVELOPMENT_OTP=false
ENABLE_DEVELOPMENT_PAYMENTS=false

# --- Everything below keeps its .env.example default; repeated here only
#     where staging commonly wants a different value ---
TRIPS_MIN_PASSENGER_PRICE_KOPECKS=10000
TRIPS_BOARDING_CODE_MAX_ATTEMPTS=5
TRIPS_BOARDING_CODE_TTL_SECONDS=300
DRIVER_LOCATIONS_BATCH_MAX_SIZE=100
DRIVER_LOCATIONS_FUTURE_TOLERANCE_SECONDS=300
DRIVER_LOCATIONS_MAX_PLAUSIBLE_SPEED_METERS_PER_SECOND=70
DRIVER_LOCATIONS_RATE_LIMIT_PER_MINUTE=120
DRIVER_LOCATIONS_STALE_AFTER_SECONDS=120
DRIVER_LOCATIONS_LATEST_POSITION_TTL_SECONDS=300
DISPATCH_AVERAGE_SPEED_METERS_PER_SECOND=8.33
DISPATCH_INITIAL_RADIUS_METERS=1000
DISPATCH_LOCATION_MAX_AGE_SECONDS=120
DISPATCH_MAX_CANDIDATES=10
DISPATCH_MAX_RADIUS_METERS=5000
DISPATCH_RADIUS_MULTIPLIER=2
DISPATCH_ROUTING_PROVIDER=straight-line
DISPATCH_ROUTING_REQUEST_TIMEOUT_MS=3000
BIDS_TTL_SECONDS=120
FINANCE_GLOBAL_COMMISSION_BASIS_POINTS=800
FINANCE_MIN_COMMISSION_KOPECKS=0
REALTIME_LOCATION_EVENT_INTERVAL_SECONDS=2
REALTIME_OUTBOX_POLL_INTERVAL_MS=1000
PRICING_BASE_FARE_KOPECKS=15000
PRICING_PER_KILOMETER_KOPECKS=3000
PRICING_PER_MINUTE_KOPECKS=800
PRICING_MINIMUM_FARE_KOPECKS=15000
PRICING_LOWER_MULTIPLIER_BASIS_POINTS=9000
PRICING_UPPER_MULTIPLIER_BASIS_POINTS=13000

# --- Push notifications: staging Firebase project only, never production
#     credentials — see docs/notifications/fcm.md and docs/notifications/apns.md ---
# PUSH_PROVIDER=staging (default) never sends a real push, safe for CI/normal
# staging use. Set PUSH_PROVIDER=fcm + the FIREBASE_* fields below only when
# deliberately running `pnpm staging:test:push` against real staging devices.
PUSH_PROVIDER=staging
PUSH_TOKEN_ENCRYPTION_KEY=
PUSH_TOKEN_HASH_SECRET=
PUSH_MAX_BATCH_SIZE=500
PUSH_MAX_ATTEMPTS=5
PUSH_INITIAL_RETRY_DELAY_SECONDS=5
PUSH_MAX_RETRY_DELAY_SECONDS=900
PUSH_WORKER_CONCURRENCY=10
PUSH_OUTBOX_POLL_INTERVAL_MS=1000
PUSH_NEW_ORDER_TTL_SECONDS=30
PUSH_ACTIVE_TRIP_TTL_SECONDS=300
PUSH_PAYMENT_TTL_SECONDS=86400
PUSH_RATE_LIMIT_REGISTER_MAX_PER_USER_HOUR=20
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=true
NOTIFICATION_DEFAULT_LOCALE=ru
NOTIFICATION_INBOX_RETENTION_DAYS=90

# --- Driver verification (Task 29, see docs/drivers/verification.md) ---
DRIVER_DATA_ENCRYPTION_KEY=
DRIVER_DATA_HASH_SECRET=
DRIVER_MINIMUM_AGE=18
DRIVER_VERIFICATION_ENABLED=true
DRIVER_REAPPLY_COOLDOWN_SECONDS=86400
DRIVER_MAX_ACTIVE_VEHICLES=3
DRIVER_REQUIRED_DOCUMENT_TYPES=PASSPORT_MAIN_PAGE,DRIVER_LICENSE_FRONT,DRIVER_LICENSE_BACK,PROFILE_PHOTO,SELFIE_WITH_DOCUMENT
VEHICLE_REQUIRED_DOCUMENT_TYPES=VEHICLE_REGISTRATION_FRONT,INSURANCE_POLICY,VEHICLE_PHOTO_FRONT,VEHICLE_PHOTO_BACK
DRIVER_ACTIVE_CITY_IDS=
DOCUMENT_IMAGE_MAX_BYTES=10485760
DOCUMENT_PDF_MAX_BYTES=15728640
DOCUMENT_PDF_MAX_PAGES=10
DOCUMENT_IMAGE_MIN_WIDTH_PX=600
DOCUMENT_IMAGE_MIN_HEIGHT_PX=600
DOCUMENT_UPLOAD_URL_TTL_SECONDS=900
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_PENDING_RETENTION_HOURS=24
# No real malware-scanning vendor is wired up yet (see
# docs/security/document-processing.md) — staging explicitly opts into the
# development (no-op) scanner rather than silently defaulting to it.
DOCUMENT_ALLOW_DEVELOPMENT_PIPELINE_IN_STAGING=true
DOCUMENT_MALWARE_SCANNER=development
DOCUMENT_FILE_TYPE_DETECTOR=development
DOCUMENT_PREVIEW_PROVIDER=development
DOCUMENT_EXPIRATION_WARNING_DAYS=30,14,7,1

# --- Backup (see docs/staging/backups.md) ---
STAGING_BACKUP_DIR=/var/backups/resilient-taxi-staging
STAGING_BACKUP_RETENTION_DAYS=14

# --- Reverse proxy / TLS (Caddy) ---
STAGING_API_DOMAIN=staging-api.example.com
STAGING_ADMIN_DOMAIN=staging-admin.example.com
ACME_EMAIL=admin@example.com
